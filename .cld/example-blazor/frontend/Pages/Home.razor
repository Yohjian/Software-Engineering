@page "/"

<PageTitle>Home — MyApp</PageTitle>

<div class="flex flex-col items-center justify-center py-20 text-center">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Welcome to MyApp</h1>
    <p class="text-gray-500 text-lg mb-8 max-w-md">
        An ASP.NET + Blazor WebAssembly starter template with JWT auth and EF Core.
    </p>
    <AuthorizeView>
        <Authorized>
            <a href="/todos"
               class="bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 transition">
                Go to Todos →
            </a>
        </Authorized>
        <NotAuthorized>
            <div class="flex gap-3">
                <a href="/login"
                   class="border border-indigo-600 text-indigo-600 px-6 py-3 rounded-lg hover:bg-indigo-50 transition">
                    Log in
                </a>
                <a href="/register"
                   class="bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 transition">
                    Register
                </a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
