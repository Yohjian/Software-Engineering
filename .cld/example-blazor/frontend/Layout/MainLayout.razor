@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthService Auth

<div class="min-h-screen flex flex-col bg-gray-50">

    <!-- Nav -->
    <header class="bg-white border-b border-gray-200 shadow-sm">
        <nav class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
            <a href="/" class="text-lg font-semibold text-indigo-600 hover:text-indigo-700">MyApp</a>
            <div class="flex items-center gap-4 text-sm">
                <a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/todos" class="text-gray-600 hover:text-gray-900">Todos</a>
                        <button @onclick="HandleLogout"
                                class="text-gray-600 hover:text-gray-900">
                            Log out
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="text-gray-600 hover:text-gray-900">Log in</a>
                        <a href="/register"
                           class="bg-indigo-600 text-white px-3 py-1.5 rounded-md hover:bg-indigo-700">
                            Register
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </nav>
    </header>

    <!-- Main -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 py-8">
        @Body
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 py-4 text-center text-xs text-gray-400">
        © @DateTime.Now.Year MyApp
    </footer>
</div>

@code {
    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
